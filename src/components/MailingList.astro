---
/**
 * Mailing-list signup.
 *
 * The form posts to /api/subscribe, which netlify.toml rewrites to the
 * `subscribe` function; that function talks to Mailchimp with a server-side
 * API key. The key never reaches the browser, and because the endpoint is
 * same-origin the CSP stays free of a Mailchimp exception.
 *
 * It works without JavaScript: the <form> has a real action and method, and
 * the function content-negotiates — a normal form post gets an HTML
 * confirmation page back, a fetch gets JSON. The script below is an
 * enhancement that keeps the visitor on the page, nothing more.
 *
 * The handoff did not spec the three non-idle states ("Needs three states not
 * designed yet"), so they are built from the tokens already on this band
 * rather than inventing a new visual language: submitting dims the button and
 * holds its width, success replaces the form with a line in the same 16px
 * body style, error prints below the field in band ink.
 */
---

<section
  id="contact"
  class="al-on-band bg-al-band py-al-signup-y text-al-band-ink"
>
  <div
    class="al-shell flex flex-wrap items-center justify-between gap-al-signup-gap px-al-gutter"
  >
    <div class="max-w-[40ch] flex-[1_1_320px]">
      <h2
        class="mb-2.5 font-head text-al-h2 font-semibold tracking-al-h2-signup"
      >
        Keep up with our latest news
      </h2>
      <p class="text-base leading-[1.6] text-al-band-ink/85">
        Hey there! We're working on some exciting new things. Subscribe for
        updates and early access.
      </p>
    </div>

    <div class="flex-[1_1_360px] sm:max-w-[520px]">
      <form
        id="signup-form"
        action="/api/subscribe"
        method="post"
        novalidate
        class="flex flex-wrap items-stretch gap-2.5"
      >
        {
          /*
          `novalidate` hands validation to the script so the error text renders
          in the designed style instead of a browser bubble — but `type=email`
          stays, because it drives the mobile keyboard and is the fallback
          check when JS is off.
        */
        }
        {
          /*
          Honeypot. Hidden from sighted visitors AND from assistive tech, and
          out of the tab order, so nothing that reads this page as a person
          would ever fill it. The function treats a filled value as a bot.
          `hidden` alone would be enough for most bots; the belt-and-braces
          attributes cost nothing and stop it being announced or focused.
        */
        }
        <div hidden aria-hidden="true">
          <label for="signup-company">Company</label>
          <input
            id="signup-company"
            name="company"
            type="text"
            tabindex="-1"
            autocomplete="off"
          />
        </div>

        <label for="signup-email" class="sr-only">Email address</label>
        <input
          id="signup-email"
          name="email"
          type="email"
          autocomplete="email"
          required
          placeholder="your@email.com"
          aria-describedby="signup-message"
          class="min-h-14 flex-[1_1_200px] rounded-full border border-al-band-ink/18 bg-al-band-field px-[22px] py-4 text-base text-al-band-ink placeholder:text-al-band-ink/65"
        />
        <button
          type="submit"
          class="min-h-14 shrink-0 rounded-full bg-al-band-ink px-7 py-4 text-[15px] text-al-band-field transition-colors duration-200 hover:bg-al-accent disabled:cursor-not-allowed disabled:opacity-70"
        >
          Notify me
        </button>
      </form>

      {
        /*
        One live region for all three outcomes. `polite` rather than
        `assertive`: the result is worth announcing but never interrupts.
        It stays in the DOM empty so the announcement fires on content change.
      */
      }
      <p
        id="signup-message"
        role="status"
        aria-live="polite"
        class="mt-3 hidden text-base leading-[1.6] text-al-band-ink"
      >
      </p>
    </div>
  </div>
</section>

<script>
  const form = document.getElementById('signup-form') as HTMLFormElement | null;
  const input = document.getElementById(
    'signup-email',
  ) as HTMLInputElement | null;
  const message = document.getElementById(
    'signup-message',
  ) as HTMLParagraphElement | null;

  if (form && input && message) {
    const button = form.querySelector(
      'button[type="submit"]',
    ) as HTMLButtonElement;

    const show = (text: string) => {
      message.textContent = text;
      message.classList.remove('hidden');
    };

    const clear = () => {
      message.textContent = '';
      message.classList.add('hidden');
    };

    /*
     * Deliberately loose. Strict RFC-5322 matching rejects addresses that are
     * genuinely deliverable, and Mailchimp validates properly on its side
     * anyway — this only exists to catch the obvious typo without a round
     * trip.
     */
    const looksLikeEmail = (value: string) =>
      /^[^@\s]+@[^@\s.]+\.[^@\s]+$/.test(value);

    form.addEventListener('submit', async (event) => {
      event.preventDefault();
      const email = input.value.trim();

      if (!looksLikeEmail(email)) {
        show('Please enter a valid email address.');
        input.focus();
        return;
      }

      clear();
      /*
       * Hold the button's rendered width while the label changes, so the form
       * does not reflow mid-submit (handoff: "disable the button, keep its
       * width").
       */
      button.style.minWidth = `${button.offsetWidth}px`;
      button.disabled = true;
      const idleLabel = button.textContent;
      button.textContent = 'Subscribing…';

      try {
        const response = await fetch(form.action, {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
            Accept: 'application/json',
          },
          body: JSON.stringify({
            email,
            company:
              (form.elements.namedItem('company') as HTMLInputElement | null)
                ?.value ?? '',
          }),
        });
        const data = await response
          .json()
          .catch(() => ({}) as { message?: string });

        if (response.ok) {
          /*
           * Success replaces the form rather than clearing it: leaving an
           * empty field next to "you're on the list" invites a second submit
           * that would only produce an "already subscribed" error.
           */
          form.remove();
          show(data.message ?? "You're on the list. We'll be in touch.");
          return;
        }

        show(data.message ?? 'Something went wrong. Please try again.');
      } catch {
        // Network-level failure — fetch rejects before any status exists.
        show(
          'Could not reach the server. Please check your connection and try again.',
        );
      } finally {
        if (button.isConnected) {
          button.disabled = false;
          button.textContent = idleLabel;
          button.style.minWidth = '';
        }
      }
    });

    // Typing after a rejection clears the message rather than leaving stale
    // error text under a field the visitor is actively fixing.
    input.addEventListener('input', clear);
  }
</script>
