---
import BaseLayout from '@/layouts/BaseLayout.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';

/**
 * The shell every page that is not the homepage renders in: same header and
 * footer, a capped reading measure, and one title block.
 *
 * The homepage does NOT use this — its bands are full-bleed and its sections
 * own their own vertical rhythm, so it composes BaseLayout directly.
 */
interface Props {
  /** Page heading, also used for the document title unless `title` is set. */
  heading: string;
  /** Optional line under the heading, e.g. a "Last Updated" date. */
  eyebrow?: string;
  title?: string;
  description?: string;
  path: string;
  /** Prose pages cap at 72ch; the team page lays out cards and wants room. */
  wide?: boolean;
  /**
   * Whether the slot is a wall of legal copy that wants the `.al-prose`
   * treatment. Pages that lay out their own sections opt out.
   */
  prose?: boolean;
  /** Extra JSON-LD, forwarded to BaseLayout. */
  schema?: Record<string, unknown>[];
}

const {
  heading,
  eyebrow,
  title,
  description,
  path,
  wide = false,
  prose = true,
  schema = [],
} = Astro.props;
---

<BaseLayout
  title={title ?? `${heading} | Awesome Labs`}
  description={description}
  path={path}
  schema={schema}
>
  <Header />
  <main id="main-content" class="al-shell px-al-gutter pt-al-hero-top pb-al-products-bottom">
    <div class={wide ? '' : 'mx-auto max-w-[72ch]'}>
      <h1 class="text-balance font-head text-al-h2 font-semibold">{heading}</h1>
      {eyebrow && <p class="mt-3 text-al-card-tag text-al-ink/75">{eyebrow}</p>}

      {/*
        Legal copy is a wall of headings and paragraphs with no per-element
        classes, so it is styled here with descendant selectors rather than by
        annotating several hundred tags. `is:global` is required: the content
        arrives through <slot />, so it carries the parent page's scope, not
        this component's.
      */}
      <div class={prose ? 'al-prose mt-10' : 'mt-10'}>
        <slot />
      </div>
    </div>
  </main>
  <Footer />
</BaseLayout>

<style is:global>
  .al-prose {
    color: --alpha(var(--color-al-ink) / 85%);
    font-size: 16px;
    line-height: 1.7;
  }

  .al-prose h2 {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 24px;
    line-height: 1.25;
    letter-spacing: -0.02em;
    color: var(--color-al-ink);
    margin: 40px 0 12px;
  }

  .al-prose h3 {
    font-family: var(--font-head);
    font-weight: 600;
    font-size: 18px;
    line-height: 1.3;
    color: var(--color-al-ink);
    margin: 28px 0 8px;
  }

  .al-prose p {
    margin: 0 0 16px;
  }

  .al-prose ul,
  .al-prose ol {
    margin: 0 0 16px;
    padding-left: 22px;
  }

  .al-prose ul {
    list-style: disc;
  }

  .al-prose ol {
    list-style: decimal;
  }

  .al-prose li {
    margin-bottom: 8px;
  }

  .al-prose a {
    color: var(--color-al-accent);
    text-underline-offset: 3px;
  }

  .al-prose strong {
    color: var(--color-al-ink);
    font-weight: 500;
  }

  /* First heading after the title block should not double up on space. */
  .al-prose > :first-child {
    margin-top: 0;
  }
</style>
